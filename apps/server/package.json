  },
  "dependencies": {
    "@bbn/shared": "workspace:*",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/ws-transport": "^0.18.4",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "colyseus": "^0.18.9"
  }
