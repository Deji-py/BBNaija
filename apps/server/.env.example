# Copy to apps/server/.env and change it. The Big Brother console (/bigbrother) asks for this.
ADMIN_SECRET=change-me

# Local default is SQLite. Production uses Postgres (pnpm --filter @bbn/server start:postgres).
# DATABASE_URL=file:./data/house.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/bbn

# Public site address. Required in production (sign-in links and payment return URLs).
# Render supplies RENDER_EXTERNAL_URL automatically, so PUBLIC_URL is optional there.
# PUBLIC_URL=https://play.example.com

# LiveKit. Leave all three unset to keep the free WebRTC mesh (pnpm dev).
# LIVEKIT_URL is the address browsers use (ws:// or wss://), not the server's private URL.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Paystack vote packs. Test keys start with sk_test_. Leave unset to hide the buy button.
# PAYSTACK_SECRET_KEY=sk_test_...
# Price is a placeholder (₦500 for 5 extra votes). Change it before any real launch.
