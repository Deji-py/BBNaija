# Production settings to paste into Render (Dashboard → your service → Environment).
# Never commit real values. To keep a copy locally, save it as .env.render, not .env:
# the dev server reads a root .env, and a Postgres DATABASE_URL there breaks local dev
# (and points it at your live database). For local development, use apps/server/.env.example.
# Render sets PORT, NODE_ENV (via the Dockerfile) and RENDER_EXTERNAL_URL itself: don't add them.

# --- Required -----------------------------------------------------------------

# Postgres connection string. On Render, use the database's "Internal Database URL"
# (or Neon/Supabase free tier). Must start with postgresql://
DATABASE_URL=postgresql://user:password@host:5432/bbn

# Password for the Big Brother console at /bigbrother. render.yaml generates one;
# set your own long random value if you created the service by hand.
ADMIN_SECRET=

# Magic-link sign-in email through Brevo (free tier: 300 emails/day, https://brevo.com).
# EMAIL_FROM must be a sender address you have verified in Brevo.
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=Big Brother Ninja

# --- Voice: strongly recommended ------------------------------------------------

# Cloudflare TURN relay so players on mobile data / strict routers can hear each other
# (free up to 1,000 GB/month). Cloudflare dashboard → Realtime → TURN → Create key.
# Paste the "Turn Token ID" and "API Token". The token never reaches browsers.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Optional -------------------------------------------------------------------

# Public site address for sign-in links and payment return URLs.
# Only needed on Render if you use a custom domain (otherwise RENDER_EXTERNAL_URL is used).
# PUBLIC_URL=https://play.example.com

# LiveKit voice server. Set all three to switch from the free mesh to LiveKit;
# leave all unset to keep the mesh + TURN above. LIVEKIT_URL is what browsers dial (wss://).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Paystack vote packs. Test keys start with sk_test_, live keys with sk_live_.
# Leave unset to hide the "buy votes" button.
# PAYSTACK_SECRET_KEY=sk_test_...
